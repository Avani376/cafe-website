# Copy this file to .env.local and fill values in. Never commit .env.local.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# No real keys belong in this file or anywhere in source code.

# --- Razorpay (test mode during development) -------------------------------
# Dashboard: Razorpay -> Settings -> API Keys (generate TEST keys first).
# Key ID. The server passes it to the client in the order response; it is
# public by design. Used to create orders and open Checkout.
RAZORPAY_KEY_ID=
# Server-side key secret. Never expose to the client. Verifies the checkout
# signature (Phase 4).
RAZORPAY_KEY_SECRET=
# Webhook signature secret, set when registering the webhook URL in the
# Razorpay dashboard. The webhook is the source of truth for paid status.
RAZORPAY_WEBHOOK_SECRET=

# --- Database (orders and payments ledger) ----------------------------------
# SQLite for local development. Only "db/cafe.db" is allowed by the
# allowlist in lib/db.ts; the db/ directory is created by the dev/build
# script. Production target is Supabase Postgres - swap the driver in
# lib/db.ts when credentials exist, then this becomes the Postgres URL.
DATABASE_URL=

# --- Email notifications ----------------------------------------------------
# Resend API key for order and feedback notifications to the cafe.
# Without it, notifications are skipped (logged) - orders still work.
RESEND_API_KEY=
# Business email that receives order and feedback notifications.
NOTIFY_EMAIL=
# Verified sender address, e.g. "Cafe Orders <orders@yourdomain.com>".
# Falls back to Resend's onboarding sender when unset.
FROM_EMAIL=
